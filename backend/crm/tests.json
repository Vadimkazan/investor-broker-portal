{
  "tests": [
    {
      "name": "Список диалогов",
      "method": "GET",
      "path": "/?action=list",
      "expectedStatus": 200
    },
    {
      "name": "Список менеджеров",
      "method": "GET",
      "path": "/?action=managers",
      "expectedStatus": 200
    },
    {
      "name": "Приём входящего из Telegram",
      "method": "POST",
      "path": "/?action=webhook&channel=telegram",
      "body": {"message": {"message_id": 1, "chat": {"id": 999000111, "first_name": "Тест", "username": "testuser"}, "text": "Здравствуйте, интересует объект"}},
      "expectedStatus": 200
    },
    {
      "name": "Приём входящего из MAX",
      "method": "POST",
      "path": "/?action=webhook&channel=max",
      "body": {"message": {"sender": {"user_id": 555000, "name": "Тест MAX"}, "recipient": {"chat_id": 555000}, "body": {"mid": "m1", "text": "Добрый день"}}},
      "expectedStatus": 200
    },
    {
      "name": "Неизвестное действие",
      "method": "GET",
      "path": "/?action=nope",
      "expectedStatus": 400
    }
  ]
}
