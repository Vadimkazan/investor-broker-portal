{
  "tests": [
    {
      "name": "Get all objects",
      "method": "GET",
      "path": "/?resource=objects",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Get all users",
      "method": "GET",
      "path": "/?resource=users",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Update user role",
      "method": "PUT",
      "path": "/?resource=users",
      "body": {
        "id": 2,
        "role": "admin"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "role": "admin"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Get all brokers",
      "method": "GET",
      "path": "/?resource=users&role=broker",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Login with correct password",
      "method": "POST",
      "path": "/?resource=auth",
      "body": {
        "action": "login",
        "email": "login.v1@yandex.ru",
        "password": "933651"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "role": "admin"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Login with wrong password",
      "method": "POST",
      "path": "/?resource=auth",
      "body": {
        "action": "login",
        "email": "login.v1@yandex.ru",
        "password": "wrongpass"
      },
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "Create investor",
      "method": "POST",
      "path": "/?resource=investors",
      "body": {
        "broker_id": 2,
        "first_name": "Тест",
        "last_name": "Инвесторов",
        "email": "test.inv@example.com",
        "phone": "+70000000000",
        "budget": 1000000,
        "source": "manual",
        "stage": "lead",
        "timeline": []
      },
      "expectedStatus": 201,
      "expectedBody": {
        "stage": "lead"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Get broker investors",
      "method": "GET",
      "path": "/?resource=investors&broker_id=2",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Create object",
      "method": "POST",
      "path": "/?resource=objects",
      "body": {
        "broker_id": 2,
        "title": "Тестовый объект",
        "city": "Москва",
        "address": "ул. Тестовая, 1",
        "property_type": "new_flat",
        "area": 50,
        "price": 5000000,
        "yield_percent": 10,
        "payback_years": 8,
        "description": "Тест",
        "images": [],
        "status": "available"
      },
      "expectedStatus": 201,
      "expectedBody": {
        "title": "Тестовый объект"
      },
      "bodyMatcher": "partial",
      "headers": {
        "Content-Type": "application/json",
        "X-User-Id": "2"
      }
    },
    {
      "name": "Create inquiry",
      "method": "POST",
      "path": "/?resource=inquiries",
      "body": {
        "object_id": 43,
        "user_id": 2,
        "name": "Тест Инвестор",
        "email": "test.inv@example.com",
        "phone": "+70000000000",
        "message": "Интересует объект"
      },
      "expectedStatus": 201,
      "expectedBody": {
        "name": "Тест Инвестор"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Get inquiries by user",
      "method": "GET",
      "path": "/?resource=inquiries&user_id=2",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Create object view",
      "method": "POST",
      "path": "/?resource=views",
      "body": {
        "user_id": 2,
        "object_id": 43
      },
      "expectedStatus": 201,
      "expectedBody": {
        "userId": 2,
        "objectId": 43
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Get views by user",
      "method": "GET",
      "path": "/?resource=views&user_id=2",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Инвестор не может выставить объект",
      "method": "POST",
      "path": "/?resource=objects",
      "headers": {
        "Content-Type": "application/json",
        "X-User-Id": "11"
      },
      "body": {
        "broker_id": 11,
        "title": "Запрещённый",
        "city": "Москва",
        "address": "тест",
        "property_type": "new_flat",
        "area": 10,
        "price": 100000,
        "yield_percent": 5,
        "payback_years": 5,
        "images": [],
        "status": "available"
      },
      "expectedStatus": 403
    },
    {
      "name": "Чужой брокер не может править объект",
      "method": "PUT",
      "path": "/?resource=objects",
      "headers": {
        "Content-Type": "application/json",
        "X-User-Id": "1"
      },
      "body": {
        "id": 43,
        "title": "Взлом"
      },
      "expectedStatus": 403
    }
  ]
}